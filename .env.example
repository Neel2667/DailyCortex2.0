# ==============================================================================
# DailyCortex 2.0 Environment Configuration Template
# DO NOT COMMIT REAL KEYS OR SECRETS TO GIT
# ==============================================================================

# Core Intelligence & Media Providers
GROQ_API_KEY=your_groq_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
SHOWTIME_BIN=showtime
EDGE_TTS_VOICE=en-US-AndrewNeural

# YouTube Data API Integration (Disabled by default!)
YOUTUBE_PUBLISHING_ENABLED=false
YOUTUBE_CLIENT_ID=your_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token_here
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
CREDENTIALS_DIR=.credentials
DEFAULT_PRIVACY_STATUS=private

# Production Factory & Scheduling
SCHEDULE_TIMEZONE=UTC
SCHEDULE_DAILY_TARGET=6
MAX_CONCURRENCY=1
